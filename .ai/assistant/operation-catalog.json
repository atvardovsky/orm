{
  "schema_version": 1,
  "catalog_kind": "target-operation-catalog",
  "project": "Doctrine ORM",
  "compact_help": ".ai/assistant/help.md",
  "human_reference": ".ai/assistant/help-reference.md",
  "routing_flow": ".ai/assistant/flows/operation-routing.flow.md",
  "health_flow": ".ai/assistant/flows/adapter-health.flow.md",
  "pre_change_preview": ".ai/assistant/templates/pre-change-preview.md",
  "module_profile": ".ai/assistant/module-profile.md",
  "fallback_operation": "help",
  "operations": [
    {
      "id": "help",
      "title": "Alatyr",
      "summary": "Show adapter state and the most relevant available actions.",
      "use_when": [
        "bare Alatyr request",
        "operation help",
        "ambiguous request"
      ],
      "context_profiles": [],
      "required_module": "core-profile",
      "flow": ".ai/assistant/flows/operation-routing.flow.md",
      "minimum_inputs": [
        "goal or suspected task area when known"
      ],
      "allowed_actions": [
        "read-only"
      ],
      "preview": "never",
      "aliases": [
        "Alatyr",
        "Alatyr help"
      ],
      "final_evidence": [
        "adapter state evidence status",
        "relevant operations",
        "next safe action"
      ]
    },
    {
      "id": "adapter-health",
      "title": "Adapter health",
      "summary": "Inspect current adapter structure and return prioritized repair routes without editing.",
      "use_when": [
        "adapter status",
        "adapter doctor",
        "suspected adapter breakage"
      ],
      "context_profiles": [
        "framework-upgrade"
      ],
      "required_module": "core-profile",
      "flow": ".ai/assistant/flows/adapter-health.flow.md",
      "minimum_inputs": [
        "optional health scope"
      ],
      "allowed_actions": [
        "read-only"
      ],
      "preview": "never",
      "aliases": [
        "Alatyr status",
        "Alatyr doctor"
      ],
      "final_evidence": [
        "health state",
        "evidence revision or time",
        "up to three repair operations"
      ]
    },
    {
      "id": "create-project-blueprint",
      "title": "Create project blueprint",
      "summary": "Create, repair, or recheck blueprint-equivalent sources from target evidence.",
      "use_when": [
        "missing blueprint",
        "stale blueprint",
        "source-of-truth repair"
      ],
      "context_profiles": [
        "business-change",
        "architecture-change"
      ],
      "required_module": "blueprint-change",
      "flow": ".ai/assistant/flows/project-blueprint-creation.flow.md",
      "minimum_inputs": [
        "blueprint scope",
        "non-goals"
      ],
      "allowed_actions": [
        "read-only",
        "docs-only",
        "full-with-approval"
      ],
      "preview": "risk-gated",
      "aliases": [
        "create blueprint",
        "repair blueprint",
        "recheck blueprint"
      ],
      "final_evidence": [
        "sources inspected",
        "facts recorded",
        "business logic layer sync",
        "gaps and approvals"
      ]
    },
    {
      "id": "recheck-after-installation",
      "title": "Recheck installation",
      "summary": "Verify a newly installed target adapter against repository evidence.",
      "use_when": [
        "post-install recheck",
        "installation verification"
      ],
      "context_profiles": [
        "framework-upgrade"
      ],
      "required_module": "core-profile",
      "flow": ".ai/assistant/flows/adapter-recheck.flow.md",
      "minimum_inputs": [
        "installation note or known gaps"
      ],
      "allowed_actions": [
        "read-only",
        "adapter-only",
        "full-with-approval"
      ],
      "preview": "risk-gated",
      "aliases": [
        "check Alatyr after installation",
        "recheck installation"
      ],
      "final_evidence": [
        "adapter findings",
        "validation",
        "remaining gaps"
      ]
    },
    {
      "id": "recheck-after-framework-update",
      "title": "Recheck framework update",
      "summary": "Assess and repair target adapter impact from an Alatyr Core update.",
      "use_when": [
        "framework update",
        "baseline change",
        "migration assessment"
      ],
      "context_profiles": [
        "framework-upgrade"
      ],
      "required_module": "core-profile",
      "flow": ".ai/assistant/flows/adapter-recheck.flow.md",
      "minimum_inputs": [
        "update source or changed framework baseline"
      ],
      "allowed_actions": [
        "read-only",
        "adapter-only",
        "full-with-approval"
      ],
      "preview": "risk-gated",
      "aliases": [
        "update Alatyr",
        "recheck Alatyr update"
      ],
      "final_evidence": [
        "migration impact",
        "adapter changes",
        "validation and residual risk"
      ]
    },
    {
      "id": "product-change",
      "title": "Product change",
      "summary": "Carry an accepted business, architecture, data, runtime, or public-contract change through all affected surfaces.",
      "use_when": [
        "business rule change",
        "architecture change",
        "data contract change",
        "public behavior change"
      ],
      "context_profiles": [
        "business-change",
        "architecture-change",
        "data-change",
        "security-sensitive"
      ],
      "required_module": "blueprint-change",
      "flow": ".ai/assistant/flows/blueprint-driven-change.flow.md",
      "minimum_inputs": [
        "change intent",
        "non-goals",
        "approval constraints"
      ],
      "allowed_actions": [
        "read-only",
        "docs-only",
        "code-and-tests",
        "full-with-approval"
      ],
      "preview": "risk-gated",
      "aliases": [
        "change business rule",
        "product change"
      ],
      "final_evidence": [
        "changed facts and owners",
        "business logic layer sync",
        "repair set",
        "validation and residual risk"
      ]
    },
    {
      "id": "logical-integrity-review",
      "title": "Logical integrity review",
      "summary": "Check changed facts, invariants, owners, and companion surfaces for consistency.",
      "use_when": [
        "suspected cross-surface drift",
        "changed invariant",
        "review item cluster"
      ],
      "context_profiles": [
        "code-local",
        "business-change",
        "architecture-change",
        "data-change",
        "security-sensitive"
      ],
      "required_module": "core-profile",
      "flow": ".ai/assistant/flows/logical-integrity-review.flow.md",
      "minimum_inputs": [
        "changed fact, suspected drift, or files to inspect"
      ],
      "allowed_actions": [
        "read-only",
        "docs-only",
        "adapter-only",
        "code-and-tests",
        "full-with-approval"
      ],
      "preview": "risk-gated",
      "aliases": [
        "check integrity",
        "logical integrity review"
      ],
      "final_evidence": [
        "invariants",
        "repair set",
        "validation and residual risk"
      ]
    },
    {
      "id": "drift-review",
      "title": "Drift review",
      "summary": "Find stale owners, derived surfaces, or adapter claims without assuming repair scope.",
      "use_when": [
        "suspected source-of-truth drift",
        "stale docs diagrams gates prompts or bridges"
      ],
      "context_profiles": [
        "docs-local",
        "code-local",
        "framework-upgrade"
      ],
      "required_module": "core-profile",
      "flow": ".ai/assistant/flows/logical-integrity-review.flow.md",
      "minimum_inputs": [
        "drift area or recently changed facts"
      ],
      "allowed_actions": [
        "read-only",
        "docs-only",
        "adapter-only",
        "code-and-tests",
        "full-with-approval"
      ],
      "preview": "risk-gated",
      "aliases": [
        "review drift",
        "find stale Alatyr facts"
      ],
      "final_evidence": [
        "drift findings",
        "owners",
        "repair recommendation"
      ]
    },
    {
      "id": "documentation-sync",
      "title": "Documentation sync",
      "summary": "Propose project-area comment styles, maintain structured comments, generate derived code reference, or synchronize other explanatory surfaces.",
      "use_when": [
        "code comment style proposal",
        "documentation profile review",
        "structured comment maintenance",
        "generated code reference",
        "documentation drift",
        "diagram sync",
        "companion assistant artifact sync"
      ],
      "context_profiles": [
        "docs-local",
        "code-local"
      ],
      "required_module": "core-profile",
      "flow": ".ai/assistant/flows/documentation-sync.flow.md",
      "minimum_inputs": [
        "changed fact and canonical owner, or bounded source area and documentation goal"
      ],
      "allowed_actions": [
        "read-only",
        "docs-only",
        "adapter-only",
        "code-and-tests",
        "full-with-approval"
      ],
      "preview": "risk-gated",
      "aliases": [
        "sync documentation",
        "sync diagrams",
        "document code",
        "propose comment style",
        "generate code docs",
        "review code documentation"
      ],
      "final_evidence": [
        "selected documentation profile and canonical owners",
        "comments and derived surfaces",
        "generator and output policy",
        "validation and residual risk"
      ]
    },
    {
      "id": "adapter-maturity-review",
      "title": "Adapter maturity review",
      "summary": "Assess task-specific adapter capability, blockers, and evidence gaps.",
      "use_when": [
        "adapter readiness review",
        "task-specific maturity",
        "broad capability review"
      ],
      "context_profiles": [
        "framework-upgrade"
      ],
      "required_module": "core-profile",
      "flow": ".ai/assistant/flows/adapter-recheck.flow.md",
      "minimum_inputs": [
        "task scope",
        "maturity concern"
      ],
      "allowed_actions": [
        "read-only"
      ],
      "preview": "never",
      "aliases": [
        "check Alatyr maturity",
        "review adapter readiness"
      ],
      "final_evidence": [
        "task maturity",
        "blocking criteria",
        "next repair operations"
      ]
    }
  ]
}
