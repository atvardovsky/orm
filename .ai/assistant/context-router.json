{
  "schema_version": 8,
  "router_kind": "target-context-router",
  "human_reference": ".ai/assistant/context-profiles.md",
  "preloaded_context": [
    "AGENTS.md"
  ],
  "bootstrap_context": [
    ".ai/assistant/bootstrap-index.json"
  ],
  "context_budgets": {
    "bootstrap": {
      "max_files": 2,
      "max_words": 2300,
      "soft_max_words": 2200
    },
    "profile_default": {
      "max_files": 20,
      "max_total_words": 12400,
      "max_portable_words": 3000,
      "reserved_target_words": 9400
    },
    "on_exceed": "load required safety and owner evidence, record expansion reason, measured context, and intentionally omitted context"
  },
  "context_receipt": {
    "required_for": [
      "budget exceeded",
      "multiple project areas",
      "cross-boundary work"
    ],
    "fields": [
      "selected profiles",
      "selected intent overlays",
      "selected task scale overlay",
      "selected project areas",
      "selected project knowledge and routing stage",
      "traversed context index chain",
      "selected context item IDs and digests",
      "resolved semantic term IDs and versions",
      "context packet digest",
      "semantic fallback or dictionary expansion",
      "loaded files and reasons",
      "approximate context volume",
      "expansion triggers",
      "intentionally omitted context",
      "residual risk"
    ]
  },
  "recursive_context": {
    "schema_version": 1,
    "contour_indexes": {
      "framework": ".ai/framework/context-index.json",
      "project": ".ai/project/context-index.json",
      "assistant": ".ai/assistant/context-index.json"
    },
    "max_depth": 8,
    "selection_order": [
      "task profile and operation",
      "workspace mode and project area",
      "fact path symbol contract and dependency selectors",
      "risk conflict and failed-validation expansion"
    ],
    "on_failure": "stop compact interpretation, load the named canonical owner when safe, and report index drift; never load the complete contour by default"
  },
  "semantic_codebook": {
    "schema_version": 1,
    "index": ".ai/framework/semantics/index.json",
    "framework_namespace": "alatyr:*",
    "project_namespace": "project:*",
    "preload_terms": [
      "alatyr:current-scope-authorization@1",
      "alatyr:canonical-owner@1",
      "alatyr:protected-change@1",
      "alatyr:logical-integrity@1",
      "alatyr:bounded-context-expansion@1"
    ],
    "conditional_loading": "load only shards referenced by selected context items, then resolve their acyclic dependency closure once",
    "fallback": "load the referenced canonical owner and do not infer a missing stale conflicting cyclic or unsupported compact term"
  },
  "context_packet": {
    "schema_version": 1,
    "template": ".ai/assistant/templates/context-packet.json",
    "receipt_required_for": [
      "budget exceeded",
      "multiple project areas",
      "cross-boundary work",
      "semantic codebook fallback",
      "material or protected change"
    ]
  },
  "operation_routing": {
    "index": ".ai/assistant/operation-index.json",
    "catalog": ".ai/assistant/operation-catalog.json",
    "fallback_operation": "help",
    "health_operation": "adapter-health",
    "single_entry_alias": "Alatyr",
    "load_index_when": [
      "exact operation ID or request alias",
      "clear operation handoff"
    ],
    "load_catalog_when": [
      "bare Alatyr entry",
      "ambiguity",
      "operation or adapter repair"
    ],
    "automatic_when": "single enabled sufficient match",
    "preview_policy": "risk-gated"
  },
  "intent_overlays": {
    "diagram-request": {
      "use_when": [
        "diagram view explanation comparison or revision request"
      ],
      "descriptor": ".ai/assistant/context/intents/diagram-request.json",
      "operation_candidates": [
        "diagram-discussion"
      ],
      "required_module": "diagrams"
    },
    "architecture-request": {
      "use_when": [
        "architecture inventory explanation pattern discussion comparison review or documentation request"
      ],
      "descriptor": ".ai/assistant/context/intents/architecture-request.json",
      "operation_candidates": [
        "architecture-assistance"
      ],
      "required_module": "architecture-knowledge"
    },
    "code-documentation": {
      "use_when": [
        "code comment style proposal documentation profile review generated code reference or documentation synchronization request"
      ],
      "descriptor": ".ai/assistant/context/intents/code-documentation.json",
      "operation_candidates": [
        "documentation-sync"
      ],
      "required_module": "code-documentation"
    },
    "vocabulary-request": {
      "use_when": [
        "project term definition acronym alias ambiguity glossary vocabulary or terminology consistency request"
      ],
      "descriptor": ".ai/assistant/context/intents/vocabulary-request.json",
      "operation_candidates": [
        "project-vocabulary"
      ],
      "required_module": "project-vocabulary"
    },
    "test-first-request": {
      "use_when": [
        "explicit test-first TDD regression-first characterization-first or contract-first request",
        "bounded recommendation trigger or test-first configuration request"
      ],
      "descriptor": ".ai/assistant/context/intents/test-first-request.json",
      "operation_candidates": [
        "test-first-configuration",
        "test-first-change"
      ],
      "required_module": "core-profile"
    },
    "extension-request": {
      "use_when": [
        "extension list inspect plan install update disable remove or review request",
        "explicit external extension source or installed extension ID"
      ],
      "descriptor": ".ai/assistant/context/intents/extension-request.json",
      "operation_candidates": [
        "extension-management"
      ],
      "required_module": "core-profile"
    },
    "dependency-knowledge-request": {
      "use_when": [
        "dependency knowledge status discovery inspection planning synchronization explanation or impact request",
        "package-manager lock change or selected dependency contract may affect the task"
      ],
      "descriptor": ".ai/assistant/context/intents/dependency-knowledge-request.json",
      "operation_candidates": [
        "dependency-knowledge"
      ],
      "required_module": "dependency-knowledge"
    },
    "workspace-mode-request": {
      "use_when": [
        "workspace mode status suggestion selection definition lifecycle or review request",
        "framework application skeleton dependency or workspace role is ambiguous"
      ],
      "descriptor": ".ai/assistant/context/intents/workspace-mode-request.json",
      "operation_candidates": [
        "workspace-mode"
      ],
      "required_module": "workspace-modes"
    }
  },
  "migration_routing": {
    "assessment_required_before_changes": true,
    "descriptor": ".ai/assistant/context/migration-routing.json"
  },
  "project_knowledge_routing": {
    "descriptor": ".ai/assistant/context/project-knowledge-routing.json",
    "initial_after": "task profile and project-area selection",
    "refined_after": "changed facts paths symbols dependencies contracts or issue lineage become known",
    "profile_only_match_allowed": false
  },
  "task_scale_overlays": {
    "large-or-resumable": {
      "use_when": [
        "explicitly large phased or resumable work",
        "multiple independently verifiable workstreams",
        "multiple project areas or task profiles",
        "profile context budget exceeded",
        "separate approval or validation checkpoints"
      ],
      "descriptor": ".ai/assistant/context/task-scales/large-or-resumable.json"
    },
    "delegated-execution": {
      "use_when": [
        "delegation"
      ],
      "descriptor": ".ai/assistant/context/task-scales/delegated-execution.json"
    },
    "change-package": {
      "use_when": [
        "coherent material outcome across multiple project surfaces",
        "semantic multi-surface approval",
        "architecture segment capability migration or public contract package",
        "audit pilot or publishable before-to-after provenance"
      ],
      "descriptor": ".ai/assistant/context/task-scales/change-package.json"
    },
    "engineering-evidence": {
      "use_when": [
        "material task finalization or explicit engineering-evidence request"
      ],
      "descriptor": ".ai/assistant/context/task-scales/engineering-evidence.json"
    },
    "debug-mode": {
      "use_when": [
        "explicit current-task or current-session Debug Mode activation",
        "status checkpoint finalization disablement or comparison for selected debug evidence"
      ],
      "descriptor": ".ai/assistant/context/task-scales/debug-mode.json"
    },
    "team-active": {
      "use_when": [
        "team identity or coordination request",
        "enabled-team write operation matches an active task branch worktree project area changed fact owner contract dependency or surface",
        "enabled-team write operation cannot rule out active-work overlap from the compact index"
      ],
      "descriptor": ".ai/assistant/team/context-overlay.json"
    }
  },
  "area_overlays": {
    "src": {
      "use_when": [
        "changes under src/",
        "Doctrine ORM runtime behavior"
      ],
      "required_context": [
        "composer.json",
        ".ai/project/code-authoring.md",
        "docs/en/reference/architecture.rst",
        ".ai/project/source-of-truth-registry.md"
      ],
      "expand_when": [
        "mapping, UnitOfWork, query, persister, hydrator, or cache behavior is affected"
      ]
    },
    "tests": {
      "use_when": [
        "changes under tests/",
        "test strategy or fixtures"
      ],
      "required_context": [
        "tests/README.markdown",
        "phpunit.xml.dist",
        ".ai/project/code-authoring.md",
        "CONTRIBUTING.md"
      ],
      "expand_when": [
        "database-specific configuration or CI matrix behavior is affected"
      ]
    },
    "docs": {
      "use_when": [
        "changes under docs/",
        "README or public documentation"
      ],
      "required_context": [
        "docs/README.md",
        "docs/en/index.rst",
        "CONTRIBUTING.md"
      ],
      "expand_when": [
        "public behavior, security, mapping, or architecture facts change"
      ]
    },
    "business-logic": {
      "use_when": [
        "changes to .ai/project/business-logic.md",
        "business-rule routing",
        "accepted ORM behavior rule family changes"
      ],
      "required_context": [
        ".ai/project/business-logic.md",
        ".ai/project/blueprint.md",
        ".ai/project/source-of-truth-registry.md",
        ".ai/assistant/context/profiles/business-change.json"
      ],
      "expand_when": [
        "canonical Doctrine docs, source, tests, or validation ownership changes"
      ]
    },
    "ci": {
      "use_when": [
        "changes under .github/workflows/",
        "validation command or CI behavior"
      ],
      "required_context": [
        ".github/workflows/continuous-integration.yml",
        ".github/workflows/static-analysis.yml",
        ".github/workflows/coding-standards.yml"
      ],
      "expand_when": [
        "Composer, PHPUnit, PHPStan, PHPCS, database matrix, or merge gate behavior changes"
      ]
    },
    "commits": {
      "use_when": [
        "creating a git commit",
        "reviewing staged changes",
        "writing or amending a commit message"
      ],
      "required_context": [
        ".ai/project/commit-policy.md",
        ".ai/project/source-of-truth-registry.md"
      ],
      "expand_when": [
        "staged diff spans independent logical scopes or commit policy changes"
      ]
    },
    "architecture": {
      "use_when": [
        "changes under .ai/project/architecture/",
        "architecture assistance or pattern discussion"
      ],
      "required_context": [
        ".ai/project/architecture/README.md",
        ".ai/project/architecture/catalog.json",
        "docs/en/reference/architecture.rst"
      ],
      "expand_when": [
        "accepted architecture boundary or public API facts change"
      ]
    },
    "dependencies": {
      "use_when": [
        "dependency knowledge, composer metadata, or lockfile impact"
      ],
      "required_context": [
        ".ai/project/dependencies/policy.json",
        ".ai/project/dependencies/catalog.json",
        "composer.json"
      ],
      "expand_when": [
        "dependency versions, trust, license, CI, or platform constraints change"
      ]
    },
    "documentation-knowledge": {
      "use_when": [
        "code documentation profile or generated documentation work"
      ],
      "required_context": [
        ".ai/project/documentation/README.md",
        ".ai/project/documentation/catalog.json",
        ".ai/project/documentation/profiles.json"
      ],
      "expand_when": [
        "public docs, generated outputs, or comment policy changes"
      ]
    },
    "vocabulary": {
      "use_when": [
        "terminology, glossary, acronym, or vocabulary consistency work"
      ],
      "required_context": [
        ".ai/project/vocabulary/README.md",
        ".ai/project/vocabulary/catalog.json",
        ".ai/project/vocabulary/terms.json"
      ],
      "expand_when": [
        "public terminology or canonical docs change"
      ]
    },
    "testing-policy": {
      "use_when": [
        "test-first trigger, test strategy, or test evidence changes"
      ],
      "required_context": [
        ".ai/project/testing/README.md",
        ".ai/project/testing/test-first-policy.json",
        "tests/README.markdown"
      ],
      "expand_when": [
        "implementation, validation gates, or CI behavior changes"
      ]
    },
    "team": {
      "use_when": [
        "team identity, task, claim, handoff, review, or decision work"
      ],
      "required_context": [
        ".ai/project/team-policy.json",
        ".ai/project/team-operating-model.md",
        ".ai/assistant/team/work-registry.json"
      ],
      "expand_when": [
        "active task overlap, external backend, or approval authority is involved"
      ]
    },
    "workspace-modes": {
      "use_when": [
        "workspace mode selection, suggestion, or lifecycle work"
      ],
      "required_context": [
        ".ai/project/workspace-modes/catalog.json",
        ".ai/project/workspace-modes/root/context.json"
      ],
      "expand_when": [
        "mode acceptance, default mode, or workspace role changes"
      ]
    },
    "ai-infrastructure": {
      "use_when": [
        "AI infrastructure inventory, recommendation, skill, prompt, tool, bridge, or extension work"
      ],
      "required_context": [
        ".ai/assistant/ai-infrastructure-router.json",
        ".ai/assistant/policies/ai-infrastructure-source-access.md",
        ".ai/assistant/policies/prompt-injection.md"
      ],
      "expand_when": [
        "third-party source, tool permission, prompt injection, or bridge capability changes"
      ]
    }
  },
  "cost_scenarios": {
    "descriptor": ".ai/assistant/context/cost-scenarios.json"
  },
  "routing_order": [
    "docs-local",
    "code-local",
    "business-change",
    "architecture-change",
    "data-change",
    "security-sensitive",
    "ai-infrastructure",
    "framework-upgrade"
  ],
  "profiles": {
    "docs-local": {
      "use_when": [
        "local wording",
        "README or documentation text",
        "non-semantic documentation change"
      ],
      "operation_candidates": [
        "documentation-sync",
        "drift-review",
        "logical-integrity-review",
        "project-knowledge"
      ],
      "descriptor": ".ai/assistant/context/profiles/docs-local.json",
      "required_context": [
        ".ai/framework/context-discovery.md",
        ".ai/assistant/gates/core.md",
        ".ai/assistant/gates/documentation.md",
        ".ai/assistant/gates/final-evidence.md",
        "README.md"
      ],
      "expand_when": [
        "semantic_fact_changes",
        "source_of_truth_conflict",
        "approval_scope_unclear",
        "diagram_or_public_contract_changes"
      ],
      "approval_gates": [
        "accepted_behavior_change",
        "security_posture_change",
        "public_contract_change",
        "approval_rule_change"
      ],
      "validation": [
        "docs validation after the docs script resolves a PHP 8-compatible composer command, or manual documentation review when docs dependencies are unavailable"
      ],
      "final_evidence": [
        "changed_docs",
        "source_of_truth",
        "skipped_checks",
        "why_no_logical_integrity_expansion"
      ]
    },
    "code-local": {
      "use_when": [
        "implementation change",
        "test change",
        "no accepted behavior change",
        "review comments or defect fixes"
      ],
      "operation_candidates": [
        "logical-integrity-review",
        "engineering-evidence",
        "project-knowledge",
        "drift-review",
        "product-change",
        "test-first-change"
      ],
      "descriptor": ".ai/assistant/context/profiles/code-local.json",
      "required_context": [
        ".ai/framework/context-discovery.md",
        ".ai/framework/change-risk-model.md",
        ".ai/framework/logical-integrity.md",
        ".ai/assistant/gates/core.md",
        ".ai/assistant/gates/code-and-tests.md",
        ".ai/assistant/gates/final-evidence.md",
        "composer.json",
        ".ai/project/code-authoring.md"
      ],
      "conditional_context": [
        {
          "path": ".ai/framework/testing-guidance.md",
          "when": "test level isolation or cross-boundary validation is unfamiliar or disputed"
        },
        {
          "path": ".ai/assistant/gates/semantic-integrity.md",
          "when": "the repair changes or may contradict an accepted semantic fact"
        },
        {
          "path": ".ai/assistant/gates/security-approval.md",
          "when": "the repair crosses a protected or security-sensitive boundary"
        }
      ],
      "expand_when": [
        "accepted_behavior_changes",
        "architecture_boundary_changes",
        "data_model_changes",
        "external_contract_changes",
        "security_posture_changes",
        "ai_infrastructure_changes",
        "shared_invariant_or_review_item_cluster_detected"
      ],
      "approval_gates": [
        "protected_category_crossed"
      ],
      "validation": [
        "/usr/local/bin/php8 -d memory_limit=1G vendor/bin/phpunit; /usr/local/bin/php8 -d memory_limit=1G vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G; /usr/local/bin/php8 -d memory_limit=1G vendor/bin/phpstan analyse -c phpstan-dbal3.neon --memory-limit=1G; /usr/local/bin/php8 -d memory_limit=1G vendor/bin/phpcs -d memory_limit=1G"
      ],
      "final_evidence": [
        "changed_files",
        "code_authoring_rules_applied",
        "re_derived_invariants",
        "review_item_reconciliation",
        "validation",
        "doc_sync_result",
        "residual_risk"
      ]
    },
    "business-change": {
      "use_when": [
        "accepted behavior change",
        "domain rule change",
        "product policy change",
        "workflow or public contract change"
      ],
      "operation_candidates": [
        "product-change",
        "create-project-blueprint",
        "logical-integrity-review",
        "engineering-evidence",
        "project-knowledge",
        "test-first-change"
      ],
      "descriptor": ".ai/assistant/context/profiles/business-change.json",
      "required_context": [
        ".ai/framework/change-risk-model.md",
        ".ai/framework/logical-integrity.md",
        ".ai/assistant/gates/core.md",
        ".ai/assistant/gates/semantic-integrity.md",
        ".ai/assistant/gates/final-evidence.md",
        ".ai/project/blueprint.md",
        ".ai/project/business-logic.md",
        ".ai/project/source-of-truth-registry.md",
        ".ai/project/consistency-map.json",
        "README.md"
      ],
      "conditional_context": [
        {
          "path": ".ai/framework/blueprint-driven-change.md",
          "when": "the accepted business decision enters planning"
        },
        {
          "path": ".ai/framework/approval-records.md",
          "when": "accepted behavior or another protected category changes"
        },
        {
          "path": ".ai/framework/testing-guidance.md",
          "when": "the decision enters implementation planning or validation"
        },
        {
          "path": ".ai/assistant/flows/blueprint-driven-change.flow.md",
          "when": "the accepted change is implemented through the product workflow"
        },
        {
          "path": ".ai/assistant/gates/security-approval.md",
          "when": "the change reaches a protected approval or security boundary"
        },
        {
          "path": ".ai/assistant/gates/checklist.md",
          "when": "adapter ambiguity or a full acceptance audit requires the complete checklist"
        },
        {
          "path": ".ai/framework/source-of-truth-registry.md",
          "when": "portable source-of-truth registry behavior is disputed or framework rules are under repair"
        },
        {
          "path": ".ai/framework/context-discovery.md",
          "when": "context budget or owner selection is disputed"
        },
        {
          "path": ".ai/project/code-authoring.md",
          "when": "implementation or test code will be changed"
        }
      ],
      "expand_when": [
        "architecture_boundary_changes",
        "data_contract_changes",
        "security_or_privacy_changes",
        "diagram_changes",
        "prompt_gate_or_bridge_changes"
      ],
      "approval_gates": [
        "accepted_business_behavior_change"
      ],
      "validation": [
        "/usr/local/bin/php8 -d memory_limit=1G vendor/bin/phpunit and relevant documentation review"
      ],
      "final_evidence": [
        "changed_fact",
        "business_logic_layer_sync",
        "consistency_map_edges",
        "derived_surface_sync",
        "re_derived_invariants",
        "review_item_reconciliation",
        "owning_blueprint_or_source_of_truth",
        "implementation_test_doc_sync",
        "approvals",
        "logical_integrity_result"
      ]
    },
    "architecture-change": {
      "use_when": [
        "module boundary change",
        "dependency direction change",
        "runtime topology change",
        "public API or cross-component contract change"
      ],
      "operation_candidates": [
        "product-change",
        "create-project-blueprint",
        "logical-integrity-review",
        "engineering-evidence",
        "project-knowledge",
        "test-first-change"
      ],
      "descriptor": ".ai/assistant/context/profiles/architecture-change.json",
      "required_context": [
        ".ai/framework/change-risk-model.md",
        ".ai/framework/logical-integrity.md",
        ".ai/assistant/gates/core.md",
        ".ai/assistant/gates/semantic-integrity.md",
        ".ai/assistant/gates/final-evidence.md",
        ".ai/project/blueprint.md",
        ".ai/project/source-of-truth-registry.md",
        ".ai/project/consistency-map.json",
        ".ai/project/architecture/catalog.json"
      ],
      "conditional_context": [
        {
          "path": ".ai/framework/blueprint-driven-change.md",
          "when": "an accepted architecture decision enters change planning"
        },
        {
          "path": ".ai/framework/approval-records.md",
          "when": "the proposed change crosses a protected architecture or dependency boundary"
        },
        {
          "path": ".ai/framework/security-safety-guidance.md",
          "when": "security privacy external service production or permission boundaries are affected"
        },
        {
          "path": ".ai/framework/testing-guidance.md",
          "when": "the accepted decision enters implementation planning or validation"
        },
        {
          "path": ".ai/assistant/flows/blueprint-driven-change.flow.md",
          "when": "the accepted decision is implemented through the blueprint workflow"
        },
        {
          "path": ".ai/assistant/gates/security-approval.md",
          "when": "the change reaches a protected approval or security boundary"
        },
        {
          "path": ".ai/assistant/gates/checklist.md",
          "when": "adapter ambiguity or a full acceptance audit requires the complete checklist"
        },
        {
          "path": ".ai/framework/context-discovery.md",
          "when": "context budget or owner selection is disputed"
        },
        {
          "path": ".ai/framework/source-of-truth-registry.md",
          "when": "portable source-of-truth registry behavior is disputed or framework rules are under repair"
        },
        {
          "path": "docs/en/reference/architecture.rst",
          "when": "accepted architecture owner detail is needed for the selected changed fact"
        },
        {
          "path": ".ai/project/code-authoring.md",
          "when": "implementation or test code will be changed"
        }
      ],
      "expand_when": [
        "data_ownership_changes",
        "external_boundary_changes",
        "security_boundary_changes",
        "new_dependency_or_service",
        "diagram_changes",
        "bridge_or_gate_changes"
      ],
      "approval_gates": [
        "architecture_change",
        "new_production_dependency_or_service"
      ],
      "validation": [
        "manual architecture review plus /usr/local/bin/php8 -d memory_limit=1G vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G when implementation changes"
      ],
      "final_evidence": [
        "architecture_owner_update",
        "re_derived_invariants",
        "review_item_reconciliation",
        "affected_areas",
        "consistency_map_edges",
        "validation",
        "diagram_result",
        "residual_risk"
      ]
    },
    "data-change": {
