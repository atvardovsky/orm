        "uncertainty_policy": "record observed behavior and unresolved intent; do not invent accepted facts"
      },
      "generation": {
        "generator": "manual review only",
        "config": "none",
        "entry_point": "documentation-sync operation",
        "output": "repository source comments or docs diffs",
        "output_policy": "committed-generated",
        "direct_edit": "forbidden",
        "publication_boundary": "source repository"
      },
      "validation": [
        "/usr/local/bin/php8 -d memory_limit=1G vendor/bin/phpcs -d memory_limit=1G",
        "/usr/local/bin/php8 -d memory_limit=1G vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G when implementation changes"
